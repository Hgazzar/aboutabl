# Copy to .env and adjust for local dev

REACT_APP_BASE_URL=http://127.0.0.1:8000/api
REACT_APP_API_SECRET=your_api_secret_here

# Student SPA base URL (used after student login via admin portal to open the handoff route)
REACT_APP_STUDENT_APP_URL=https://student.aboutabl.com

# Laravel Echo + laravel-websockets (Pusher protocol)
REACT_APP_PUSHER_APP_KEY=
REACT_APP_PUSHER_APP_CLUSTER=mt1
REACT_APP_PUSHER_HOST=127.0.0.1
REACT_APP_PUSHER_PORT=6001
REACT_APP_PUSHER_SCHEME=http
