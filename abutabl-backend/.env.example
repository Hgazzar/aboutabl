APP_NAME=OneSave
APP_ENV=local
APP_KEY=base64:qyDuSfLn3udhL19FB2WNTk4tltuaKuqFsV7x51yYKCA=
APP_DEBUG=true
APP_URL=http://localhost

# My Work uploads: Laravel validates up to 100MB per file.
# Ensure PHP also allows it (Herd php.ini): upload_max_filesize=128M, post_max_size=128M

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onesave
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
INTERACTIVE_GAMES_ENABLED=true
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@aboutabl.com
MAIL_FROM_NAME=ABOUTABL

# Landing Contact Us inbox
CONTACT_MAIL_TO=info@aboutabl.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_APP_HOST=127.0.0.1
PUSHER_APP_PORT=6001
PUSHER_APP_SCHEME=http

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
MIX_PUSHER_APP_HOST="${PUSHER_APP_HOST}"
MIX_PUSHER_APP_PORT="${PUSHER_APP_PORT}"
MIX_PUSHER_APP_SCHEME="${PUSHER_APP_SCHEME}"
MIX_CONTENT_DIRECTION ="rtl"

# JWT (required for admin/student login) — run: php artisan jwt:secret
JWT_SECRET=

# API secret header (must match REACT_APP_API_SECRET in abutabl-admin)
API_SECRET=OASzRok654E0AJ20KH

# Local My Progress UI QA — Activities chips (never enable in production)
MY_PROGRESS_DEMO_ACTIVITIES=false
