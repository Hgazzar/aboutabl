# Student portal API base URL (no trailing slash)
# Local: http://127.0.0.1:8000/api/student
VITE_BASE_URL=https://aboutabl.com/api/student

# API secret (must match backend CheckSecretApi / config)
VITE_API_SECRET=your_api_secret_here

# Interactive games + Laravel Echo (Pusher protocol / laravel-websockets)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http
