# Student portal API base URL (no trailing slash)
# Local dev (recommended): same-origin proxy in vite.config.ts → http://127.0.0.1:8000
VITE_BASE_URL=/api/student
# Production direct (browser CORS may block apiSecret header from localhost):
# VITE_BASE_URL=https://aboutabl.com/api/student

# API secret (must match backend CheckSecretApi / config)
VITE_API_SECRET=OASzRok654E0AJ20KH

# Admin SPA origin (staff redirect after shared Welcome Back login)
VITE_ADMIN_APP_URL=http://127.0.0.1:3000

# Interactive games + Laravel Echo (Pusher protocol / laravel-websockets)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http
